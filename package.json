{
	"name": "wszczawinski.github.io",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@fontsource/fira-mono": "5.3.0",
		"@iconify/svelte": "5.2.4",
		"@sveltejs/adapter-vercel": "^6.3.5",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "26.6.6",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.0",
		"globals": "17.14.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.6",
		"vite-plugin-checker": "0.14.5"
	},
	"dependencies": {
		"@lucide/svelte": "0.577.0",
		"@tanstack/svelte-query": "6.3.11",
		"@tanstack/svelte-query-devtools": "6.3.11",
		"@threlte/core": "8.7.0",
		"@threlte/extras": "9.23.1",
		"@types/three": "0.187.0",
		"@vercel/analytics": "2.0.1",
		"@vercel/speed-insights": "2.1.0",
		"highlight.js": "11.12.0",
		"prettier-plugin-tailwindcss": "0.8.1",
		"three": "0.187.0"
	},
	"packageManager": "pnpm@10.30.3",
	"pnpm": {
		"overrides": {
			"cookie": "0.7.0",
			"esrap": "2.2.11",
			"rollup": "4.62.2",
			"yaml": "2.9.0"
		},
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
